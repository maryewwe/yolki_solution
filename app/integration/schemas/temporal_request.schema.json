{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-monitoring.local/schemas/temporal_request.schema.json",
  "title": "Construction monitoring temporal update request",
  "type": "object",
  "additionalProperties": false,
  "required": ["observations"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "analysis_request.schema.json"},
      "description": "All observations must share planned_work, camera_id, zone_id and active_conditions; timestamps must be unique."
    },
    "temporal_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "default": null
        },
        "min_observations": {"type": "integer", "minimum": 1, "default": 3},
        "persistence_ratio": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "default": 0.75
        }
      }
    }
  }
}
